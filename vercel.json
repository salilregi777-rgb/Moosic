{
  "installCommand": "pnpm run setup",
  "buildCommand": "pnpm run build",
  "outputDirectory": "Frontend/MOOSIC-visual-refresh-final/MOOSIC-visual-refresh/artifacts/moodsic/dist/public",
  "rewrites": [{ "source": "/((?!assets/|favicon.svg|robots.txt).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "X-Content-Type-Options", "value": "nosniff" }
  ] }]
}
